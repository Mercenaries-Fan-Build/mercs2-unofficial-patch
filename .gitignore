# qm output. Built artifacts are reproducible from the manifest and src/, and a committed WAD is a
# 2 MB binary that will conflict on every merge.
build/

.DS_Store
Thumbs.db

# Built native artifact. Reproduced by `make -C native` (which auto-fetches the pinned SDK); a
# committed binary is the one a consumer accidentally ships instead of the one they just built.
src/unofficial_patch.asi

# Fetched m2-sdk release (headers, import library, runtime DLL) — populated by
# `scripts/fetch-sdk.sh` or invoked implicitly by `make -C native`. The pin lives in
# scripts/fetch-sdk.sh (version + sha256 per asset); checking the binaries in would make the
# reproducibility story a lie.
.sdk/
